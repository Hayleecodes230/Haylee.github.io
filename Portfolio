<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title> Haylee Martin | Data Engineering Portfolio</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #11111b;
      color: #f5f3ff;
      line-height: 1.7;
    }

    header {
      padding: 25px 8%;
      background: #191827;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
    }

    header h2 {
      color: #b9a5ff;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 18px;
    }

    nav a:hover {
      color: #b9a5ff;
    }

    section {
      padding: 65px 10%;
    }

    .hero {
      min-height: 400px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .hero h1 {
      font-size: 42px;
      color: #c4b5fd;
    }

    .hero p {
      max-width: 600px;
      margin-top: 15px;
      color: #c4c1d5;
    }

    h2 {
      margin-bottom: 20px;
      color: #c4b5fd;
    }

    .skills, .projects {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 18px;
    }

    .card {
      background: #201e32;
      padding: 22px;
      border-radius: 12px;
      border: 1px solid #39344e;
    }

    .card p {
      color: #c4c1d5;
      margin-top: 8px;
    }

    .card a {
      display: inline-block;
      margin-top: 12px;
      color: #c4b5fd;
    }

    .contact a {
      color: #c4b5fd;
    }

    footer {
      text-align: center;
      padding: 25px;
      background: #191827;
      color: #aaa5bd;
    }

    @media (max-width: 600px) {
      header {
        flex-direction: column;
      }

      nav a {
        margin: 0 6px;
      }

      .hero h1 {
        font-size: 32px;
      }
    }
  </style>
</head>

